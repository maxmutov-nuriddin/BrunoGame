{
  "name": "nitro-clash",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run typecheck && tsx --test --test-concurrency=1 scripts/tests/vehicle.test.ts scripts/tests/race.test.ts scripts/tests/lobby.test.ts scripts/tests/p2p.test.ts scripts/tests/multiplayer.test.ts",
    "test:vehicle": "tsx --test scripts/tests/vehicle.test.ts",
    "test:race": "tsx --test scripts/tests/race.test.ts",
    "test:multiplayer": "tsx --test --test-concurrency=1 scripts/tests/multiplayer.test.ts",
    "model:cars": "node scripts/build-cars.mjs",
    "model:world": "node scripts/build-world-pack.mjs",
    "model:check": "node scripts/check-vehicle.mjs",
    "bench": "tsx scripts/bench.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.17.3",
    "firebase": "^13.1.0",
    "qrcode-generator": "^2.0.4",
    "three": "^0.179.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.179.0",
    "meshoptimizer": "^1.3.0",
    "typescript": "^5.9.3",
    "vite": "^6.2.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
