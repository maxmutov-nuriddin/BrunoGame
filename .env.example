# ---- Firebase (online play and accounts) ----
# Copy to .env and fill in from Firebase console → Project settings → Your apps → Web app config.
# These values are not secrets: they identify the project. Access is enforced by firestore.rules and
# database.rules.json. On Netlify, set the same variables under Site settings → Environment variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_APP_ID=

# Without Firebase config, online play still works between tabs of the same browser during
# development (npm run dev), through a BroadcastChannel stand-in. Production builds need Firebase.
