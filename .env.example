# ---- Multiplayer server (server/main.ts) ----
# Port the HTTP + WebSocket server listens on.
PORT=8787
# Interface to bind. 0.0.0.0 accepts connections from other devices on your network.
HOST=0.0.0.0
# Comma-separated list of page origins allowed to open a WebSocket. Empty = any (development only).
# Example: ALLOWED_ORIGINS=https://race.example.com,http://localhost:5173
ALLOWED_ORIGINS=
# How long a disconnected player keeps their seat (ms).
LOBBY_GRACE_MS=20000
RACE_GRACE_MS=60000
# Max wait for every client to finish building the track before the countdown starts anyway (ms).
LOAD_TIMEOUT_MS=20000
MAX_ROOMS=200
# Per-connection rate limit (messages per second, and burst).
MESSAGES_PER_SECOND=90
MESSAGE_BURST=180
# Simultaneous sockets from one IP, and whether to trust X-Forwarded-For (only behind your own proxy).
MAX_CONNECTIONS_PER_IP=12
TRUST_PROXY=0

# ---- Frontend build (vite) ----
# Public WebSocket URL of the multiplayer server, baked in at build time.
# Leave empty to use the page's own host on port 8787 (ws:// on http, wss:// on https).
# Example: VITE_SERVER_URL=wss://race-server.example.com/ws
VITE_SERVER_URL=
